Host bunker
  HostName bunker.dyndns.imaginator.com
  User simon
  ForwardAgent yes

Host bunker-unlock
  HostName bunker.imagilan
  User root
  Port 2222
  IdentityFile ~/.ssh/luks-unlock
  IdentitiesOnly yes
  UserKnownHostsFile ~/.ssh/known_hosts-initramfs

Host bunker-external
    HostName 10.7.11.10
    User simon
    ProxyJump root@711gw.dyndns.imaginator.com
    AddressFamily inet

Host github.com
  IdentityFile          ~/.ssh/id_github
  User                  imaginator

Host gist.github.com
  IdentityFile          ~/.ssh/id_github
  User                  imaginator

Host ilo.imagilan
  KexAlgorithms         diffie-hellman-group1-sha1

Host repeater*
  ForwardAgent yes
  User                  root

Host *gw
  ForwardAgent yes
  User                  root

Host *
  IdentityFile          ~/.ssh/id_simon
  ForwardAgent          yes
  ServerAliveInterval   60
  ServerAliveCountMax   30
  ForwardX11            yes
  ForwardX11Trusted     no
  VisualHostKey         yes
  AddKeysToAgent        yes
